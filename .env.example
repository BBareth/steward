# steward configuration. Copy to .env (scripts/init-config.sh does this and
# generates the MCP token), then fill in the Discord values.
# .env holds secrets: keep it out of git and readable only by you (chmod 600).

# ---- Discord ------------------------------------------------------------------

# Bot token from https://discord.com/developers/applications -> your app -> Bot.
# Required. Or put it in a file and set DISCORD_TOKEN_FILE=/run/secrets/discord_token.
DISCORD_TOKEN=

# Comma-separated server (guild) IDs steward may manage. Required. Anything
# else is refused, even if the bot has been invited there.
# Enable Developer Mode in Discord, right-click the server icon -> Copy Server ID.
DISCORD_GUILD_IDS=

# Request the privileged "Server Members" gateway intent. Needed only for
# welcome messages and join roles. Turn on "Server Members Intent" in the
# developer portal (Bot page) first, or the bot will fail to connect.
DISCORD_MEMBERS_INTENT=false

# ---- MCP access -----------------------------------------------------------------

# The credential MCP clients send as "Authorization: Bearer <token>".
# Required (or MCP_TOKENS_FILE). At least 32 characters. Generate one with:
#   node scripts/generate-token.mjs      (or: openssl rand -base64 36)
# This is NOT the Discord token; clients never see the Discord token.
MCP_AUTH_TOKEN=

# Scopes for MCP_AUTH_TOKEN: read, write, destructive (write implies read,
# destructive implies write). Default: all three.
# MCP_AUTH_TOKEN_SCOPES=read,write,destructive

# Optional JSON file with several hashed credentials, each with its own scopes
# and guild list. See docs/SETUP.md#several-clients. Mount it read-only.
# MCP_TOKENS_FILE=/run/secrets/steward-tokens.json

# Host names (or IPs) clients use to reach steward, without scheme. Requests
# with any other Host header are refused (DNS-rebinding protection).
# Default: localhost,127.0.0.1,[::1]. Add your LAN/VPN address or name, e.g.
#   MCP_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.20,steward.lan,nas.tailnet-name.ts.net
MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# Browser origins allowed to call /mcp. Leave empty: CLI agents send no Origin,
# and refusing browsers is the safe default.
MCP_ALLOWED_ORIGINS=

# ---- Safety switches -------------------------------------------------------------

# Inspection only: every tool that changes Discord is disabled.
READ_ONLY=false

# Allow deleting channels, roles, messages, AutoMod rules and panels, and
# applying plans that prune. Off by default; turn on when you need it.
ALLOW_DESTRUCTIVE=false

# ---- Docker Compose publishing ---------------------------------------------------

# Address on the Docker host the port is published on. 127.0.0.1 keeps it
# local. Set your host's LAN or VPN IP (e.g. 192.168.1.20 or a Tailscale
# 100.x address) to reach it from other machines. Avoid 0.0.0.0 unless a
# firewall keeps the port off the internet.
STEWARD_BIND_ADDRESS=127.0.0.1
STEWARD_PORT=8787

# ---- Tuning (defaults are fine) --------------------------------------------------

# How long a plan stays valid, in minutes.
# PLAN_TTL_MINUTES=30
# How long apply_plan waits before returning "running" (poll get_apply_status).
# APPLY_WAIT_SECONDS=40
# Discord request timeout. A timed-out create is checked, never blindly retried.
# DISCORD_REQUEST_TIMEOUT_MS=15000
# debug, info, warn or error. Secrets are redacted at every level.
# LOG_LEVEL=info
